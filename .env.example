# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
#
# This is the ONE config file for the whole app — backend, frontend, and docker-compose all
# read it (docker-compose.yml auto-loads a .env file beside itself; the backend loads it via
# `dotenv/config` in src/config.ts; web/next.config.js and web/scripts/with-frontend-port.js
# load it explicitly from the repo root). There is no separate web/.env.local anymore.

# Get both connection strings from the Supabase dashboard:
# Project Settings -> Database -> Connection string
#
# DATABASE_URL: the Supavisor pooler in TRANSACTION mode (port 6543). This is the connection
# the app uses for everything, including the raw-SQL lock-sensitive operations
# (transfer_ownership, the advisory-lock move logic) — see APPLICATION_DESIGN.md §1.3/§1.3.1
# for why transaction-mode pooling is safe here specifically because every advisory lock this
# schema takes uses pg_advisory_xact_lock, never the session-scoped variant.
DATABASE_URL="DB_URL_HERE"

# DIRECT_URL: a non-pooled connection (port 5432), used only by `prisma db pull` /
# `prisma generate` for introspection — Prisma's introspection is unreliable through a
# transaction-mode pooler. Never used by the running application itself.
DIRECT_URL="URL_HERE"

# Session cookie signing/config
SESSION_COOKIE_NAME="dbase_session"
# Refresh-token lifetime, in days.
SESSION_TTL_DAYS=30

# REQUIREMENTS.md §5.1: every new self-registered account starts with some defined,
# non-negative quota. Bytes. (16106127360 = 15 GiB, this deployment's current default.)
DEFAULT_USER_QUOTA_BYTES=16106127360

# Password-reset token lifetime, in minutes.
PASSWORD_RESET_TTL_MINUTES=30

# Email-verification token lifetime, in hours.
EMAIL_VERIFICATION_TTL_HOURS=24

# ---------------------------------------------------------------------------------------------
# Ports — change any of these if the default collides with something else already running on
# this machine (another app, another MinIO, etc). Each one drives BOTH the container's internal
# listening port and its published host port in docker-compose.yml (they're always the same
# number by design — Docker isolates each compose project's internal network anyway, so only the
# host-published side can ever collide with another process; keeping them equal just avoids
# needing two numbers per service). For non-Docker (`npm run dev`) these are the literal port the
# process binds to.
# ---------------------------------------------------------------------------------------------

# Backend (Fastify) port.
PORT=3000

# Frontend (Next.js) port. Read by web/scripts/with-frontend-port.js, which sets Next's own PORT
# env var for the child `next` process — kept as a separate name from PORT above since both
# services share this one file and PORT alone would be ambiguous between them.
FRONTEND_PORT=3001

# docker-compose.yml reads these directly (Docker Compose auto-loads a .env file in the same
# directory as the compose file) — set your own values, do not use these placeholders as-is.
MINIO_ROOT_USER="dbase_admin"
MINIO_ROOT_PASSWORD="change-me-to-something-real"

# The running backend's own MinIO credentials (src/config.ts). Inside docker-compose, the
# backend service maps these from MINIO_ROOT_USER/MINIO_ROOT_PASSWORD above automatically — these
# two lines only matter for running the backend OUTSIDE Docker (`npm run dev`) against a MinIO
# container started with `docker compose up minio`, where they must match the values above.
MINIO_ACCESS_KEY="dbase_admin"
MINIO_SECRET_KEY="change-me-to-something-real"
MINIO_ENDPOINT="localhost"

# MinIO S3 API port. In docker-compose.yml this is also the published host port — change it if
# another MinIO (or anything else) on this machine already has 9000 taken.
MINIO_PORT=9000

# MinIO web console port (docker-compose only — nothing outside MinIO itself talks to this one).
# Same collision-avoidance reasoning as MINIO_PORT above.
MINIO_CONSOLE_PORT=9001

MINIO_USE_SSL=false
MINIO_BUCKET="dbase"

# Tier-1 encryption at rest: MinIO's built-in single-key KMS. Format is
# "<key-name>:<32-byte-base64-key>" — generate a real one with:
#   echo "dbase-master:$(openssl rand -base64 32)"
# Do not reuse the placeholder below, and use a DIFFERENT key per environment (never copy your
# local dev key to production). No rotation support in this single-key mode — see docs/DESIGN.md.
MINIO_KMS_SECRET_KEY="dbase-master:change-me-to-a-real-32-byte-base64-key"

# ---------------------------------------------------------------------------------------------
# Deploying somewhere other than localhost? These are the settings that actually need to change.
# ---------------------------------------------------------------------------------------------
# The one browser-visible "localhost" left after a docker-compose deployment: every file
# download/preview/thumbnail URL is a MinIO presigned link, and it's built from THIS host, not
# from wherever the app's own domain is (the backend and MinIO are two separate origins from the
# browser's point of view). Left unset, it silently falls back to "localhost" (docker-compose.yml)
# — harmless on your own machine, broken for literally everyone else, since "localhost" resolves
# to their own machine, not yours. Set this to whatever domain/IP MinIO's S3 API is actually
# reachable at from a browser.
MINIO_PUBLIC_ENDPOINT="localhost"

# Defaults to MINIO_PORT above — if you changed MINIO_PORT to dodge a collision, set this to the
# same value too (unless MinIO sits behind its own separate reverse proxy on a different port).
MINIO_PUBLIC_PORT=9000

MINIO_PUBLIC_USE_SSL=false

# Only needed if the frontend and backend are NOT both running under this same
# docker-compose.yml (e.g. split across two separate hosts/services), OR if you're running
# without Docker and the frontend needs to reach the backend somewhere other than
# "http://localhost:<PORT>" (web/next.config.js's default, derived from PORT above). See
# docker-compose.yml's comment on the frontend build arg for why the Docker default
# ("http://backend:<PORT>", Docker-internal networking) is normally correct regardless of your
# public domain and doesn't need to be touched.
# BACKEND_URL="http://backend:3000"

# The link target baked into every verification/password-reset email (src/modules/accounts/
# service.ts) — must be wherever a real browser can reach the FRONTEND, i.e. your actual public
# domain, not the backend's. Also change this one for a non-localhost deployment.
PUBLIC_APP_URL="http://localhost:3001"

# ---------------------------------------------------------------------------------------------
# Email — signup verification links and password-reset links (src/lib/email.ts, via Resend's
# API). Left blank, both flows still work end-to-end for local testing — the email just gets
# logged to the backend's own console instead of actually being sent.
# ---------------------------------------------------------------------------------------------
# 1. Sign up at https://resend.com (free tier: 100 emails/day, 3000/month).
# 2. Dashboard -> API Keys -> Create API Key -> paste the value below.
# 3. EMAIL_FROM: resend.dev's shared test domain (default below) works immediately with no setup,
#    but only delivers to the email you signed up to Resend with. To send to anyone, Dashboard ->
#    Domains -> add and verify a domain you control, then set EMAIL_FROM to an address at that
#    domain (e.g. "noreply@yourdomain.com").
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"
