{
  "name": "dbase-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Two-way folder sync between a local directory and DBase.",
  "type": "module",
  "bin": {
    "dbase-sync": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
