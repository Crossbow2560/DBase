# Copy to .env.local. The backend the reverse proxy (next.config.js) forwards /api/v1/* to.
# This app itself runs on port 3001 (see package.json's dev/start scripts) specifically so it
# never collides with the backend's own port 3000 — both defaulted to 3000 originally, which on
# this machine silently resulted in two processes bound to the same port with no error, an
# ambiguous state where requests could hit either one nondeterministically.
BACKEND_URL="http://localhost:3000"
